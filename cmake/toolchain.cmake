set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR mipsel)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(TOOLCHAIN_PATH "" CACHE PATH "Directory containing the MIPS GCC toolchain")
find_program(PS1_GCC mipsel-none-elf-gcc HINTS "${TOOLCHAIN_PATH}" "${TOOLCHAIN_PATH}/bin" REQUIRED)
string(REGEX MATCH "^(.+-)gcc(.*)$" _unused "${PS1_GCC}")
set(CMAKE_C_COMPILER "${CMAKE_MATCH_1}gcc${CMAKE_MATCH_2}")
set(CMAKE_ASM_COMPILER "${CMAKE_MATCH_1}gcc${CMAKE_MATCH_2}")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
